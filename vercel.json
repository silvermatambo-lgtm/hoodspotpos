{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": ["fra1"],
  "rewrites": [
    {"source":"/api/v1","destination":"/api/pos?route=discovery"},
    {"source":"/api/v1/","destination":"/api/pos?route=discovery"},
    {"source":"/api/v1/:path*","destination":"/api/pos?route=:path*"},
    {"source":"/workstation","destination":"/index.html"},
    {"source":"/owner","destination":"/index.html"}
  ],
  "headers": [
    {"source":"/(.*)","headers":[{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"no-referrer"},{"key":"X-Frame-Options","value":"DENY"},{"key":"X-Robots-Tag","value":"noindex, nofollow"}]},
    {"source":"/sw.js","headers":[{"key":"Cache-Control","value":"no-cache"}]},
    {"source":"/api/pos","headers":[{"key":"Cache-Control","value":"private, no-store"}]}
  ]
}
